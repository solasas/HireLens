# ---- Application ----
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL ----
# POSTGRES_HOST is overridden to "db" automatically when running via docker-compose.
POSTGRES_USER=hirelens
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hirelens

# ---- LLM provider ----
# One of: openai, gemini (only gemini is implemented so far)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Embedding provider ----
# One of: openai, gemini (only gemini is implemented so far)
EMBEDDING_PROVIDER=openai
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
